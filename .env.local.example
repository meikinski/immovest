# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe Payment
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (extrahiere diese aus deinen Stripe Payment Links oder Produkten)
# Monatsabo: 13,99€/Monat - Payment Link: https://buy.stripe.com/test_6oUeVe5H038238bLfZc1wY02
# Jahresabo: 69€/Jahr - Payment Link: https://buy.stripe.com/test_3cIeVe2uO2HJajTfZc1wY03
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=price_...

# Supabase Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API
OPENAI_API_KEY=sk-...

# Anthropic API (für Chat-Assistent)
ANTHROPIC_API_KEY=sk-ant-...

# Google Tag Manager & Analytics (optional - for tracking and AI-driven insights)
# Get GTM ID from: https://tagmanager.google.com
# Get GA4 Measurement ID from: https://analytics.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Interner Traffic: Konten mit diesen (bestätigten) E-Mail-Adressen senden traffic_type=internal an jedem Event.
# Kommagetrennt, nur serverseitig (kein NEXT_PUBLIC_), die Adressen erreichen nie den Browser.
INTERNAL_USER_EMAILS=

# Fehlerüberwachung (Sentry, siehe docs/MONITORING.md). Ohne DSN ist die Überwachung aus.
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org-id>.ingest.de.sentry.io/<project-id>
# Optional: lesbare Stacktraces (Sourcemaps-Upload beim Build)
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=imvestr
SENTRY_PROJECT=imvestr-web
# Optional: Salz für den Hash der Nutzer-ID (beliebige Zeichenkette, nicht ändern, sonst neue Hashes)
NEXT_PUBLIC_MONITORING_HASH_SALT=
